{
    "name": "nikak/laravel-inexphone-sms",
    "description": "Laravel package for the InexPhone SMS API",
    "type": "library",
    "license": "MIT",

    "autoload": {
        "psr-4": {
            "Inexphone\\Sms\\": "src/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },

    "authors": [
        {
            "name": "PrayerPosition",
            "email": "nika.kapana23@gmail.com"
        }
    ],

    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0"
    },

    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "laravel/framework": "^13.30"
    },

    "extra": {
        "laravel": {
            "providers": [
                "Inexphone\\Sms\\SmsServiceProvider"
            ]
        }
    }
}
